{
  "name": "vibe-surgeon",
  "version": "0.2.1",
  "description": "Local review signals for AI-assisted code: dependency impact, Git change guard, MCP and SARIF.",
  "type": "module",
  "bin": {
    "vibe-surgeon": "./bin/vibe-surgeon.mjs",
    "vsurgeon": "./bin/vibe-surgeon.mjs"
  },
  "scripts": {
    "test": "node --test",
    "smoke": "node ./bin/vibe-surgeon.mjs scan . --json > /tmp/vibe-scan.json && node ./bin/vibe-surgeon.mjs map . --json > /tmp/vibe-map.json && node ./bin/vibe-surgeon.mjs context . && node ./bin/vibe-surgeon.mjs sarif .",
    "check": "npm test && npm run smoke",
    "demo": "node scripts/demo.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "vibe-coding",
    "ai-coding",
    "claude-code",
    "codex",
    "cursor",
    "mcp",
    "developer-tools",
    "code-quality",
    "static-analysis",
    "agent",
    "sarif"
  ],
  "license": "MIT",
  "files": [
    "bin",
    "src",
    "templates",
    "assets",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "scripts/demo.mjs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adilusrr-gif/vibe-surgeon.git"
  },
  "bugs": {
    "url": "https://github.com/adilusrr-gif/vibe-surgeon/issues"
  },
  "homepage": "https://github.com/adilusrr-gif/vibe-surgeon#readme"
}
